{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/assets/:dir(planets|icons)/:file",
      "destination": "/:dir/:file"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
